# Create this key INSIDE Bybit Demo Trading on the ordinary mainnet website.
# Keep both values private. Never use a funded-account or Testnet key here.
TRADING_MODE=demo
ENABLE_LIVE_TRADING=false
# Set true to keep testing despite daily losses, loss streaks and loss cooldown.
# DEMO only; technical consistency checks and position sizing remain active.
DEMO_CONTINUOUS_TESTING=false
MARKET_DATA_NETWORK=mainnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYMBOLS=BTCUSDT,ETHUSDT
LEVERAGE=1
MAX_LEVERAGE=3
RISK_PER_TRADE_PERCENT=0.25
# Optional allocation limit; example for an approximately 2000 RUB budget.
TRADING_CAPITAL_USDT=23.95
MAX_DAILY_LOSS_PERCENT=2
MAX_OPEN_POSITIONS=1
DATABASE_PATH=data/demo.db
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
