# Safe default: public Bybit TESTNET, signals only. Existing .env is never overwritten.
# No real credentials belong in this file. Node 24 LTS recommended.
NODE_ENV=development
LOG_LEVEL=info
# signal | paper | testnet | demo | live. For Bybit Demo Trading use .env.demo.
TRADING_MODE=signal
ENABLE_LIVE_TRADING=false
MARKET_DATA_NETWORK=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYMBOLS=BTCUSDT,ETHUSDT
RISK_PER_TRADE_PERCENT=0.25
# Optional: cap risk and margin allocation, e.g. TRADING_CAPITAL_USDT=23.95
MAX_DAILY_LOSS_PERCENT=2
MAX_OPEN_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_MINUTES=5
SIGNAL_COOLDOWN_SECONDS=60
LEVERAGE=1
MAX_LEVERAGE=3
MIN_SIGNAL_SCORE=70
MIN_CONFIRMATIONS=3
SL_ATR_MULTIPLIER=1.2
TP_ATR_MULTIPLIER=1.8
MIN_RR=1.3
ORDERBOOK_LEVELS=10
ENTRY_ORDER_TYPE=Limit
POST_ONLY=true
ORDER_TIMEOUT_SECONDS=20
MAKER_FEE_BPS=2
TAKER_FEE_BPS=5.5
SLIPPAGE_BPS=2
BACKTEST_SPREAD_BPS=2
PAPER_INITIAL_EQUITY=10000
BREAKEVEN_ENABLED=true
BREAKEVEN_TRIGGER_R=1
TRAILING_STOP_ENABLED=false
TRAILING_ATR_MULTIPLIER=1
AUTO_CLOSE_ON_SHUTDOWN=false
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_PERIOD=14
ATR_PERIOD=14
VOLUME_PERIOD=20
RSI_LONG_MIN=45
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=55
VOLUME_MULTIPLIER=1.1
BOOK_IMBALANCE_MIN=1.15
MAX_SPREAD_BPS=5
MAX_ATR_PERCENT=1
WEIGHT_TREND=25
WEIGHT_EMA=20
WEIGHT_VWAP=15
WEIGHT_RSI=10
WEIGHT_VOLUME=15
WEIGHT_BOOK=10
WEIGHT_SPREAD=5
MARKET_STALE_MS=15000
CANDLE_STALE_MS=180000
PRIVATE_DISCONNECT_MS=30000
EXCHANGE_ERROR_THRESHOLD=5
REST_TIMEOUT_MS=10000
RECONCILE_INTERVAL_MS=15000
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_PATH=data/bot.db
